/* pages/user/index.wxss */

.container {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.user-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  margin: 0 12rpx;
  color: rgba(255, 255, 255, 0.5);
}

.vip-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.vip-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.vip-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 会员状态区域 */
.member-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.member-section:active {
  transform: scale(0.98);
}

.member-section.vip {
  background: rgba(255, 215, 0, 0.2);
}

.member-prompt {
  display: flex;
  align-items: center;
  flex: 1;
}

.prompt-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.prompt-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.member-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 功能菜单 */
.menu-section {
  margin-bottom: 32rpx;
}

.menu-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
  transition: all 0.3s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F7F8FA;
  margin: 0 -32rpx;
  padding: 32rpx;
}

.menu-item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333333;
}

.menu-item-right {
  display: flex;
  align-items: center;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #FF6B6B;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 18rpx;
  padding: 0 8rpx;
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 32rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #999999;
}

/* 联系方式弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.contact-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  padding: 8rpx;
}

.contact-list {
  padding: 0 16rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666666;
}

.contact-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.btn-copy {
  background: #07C160;
  color: #FFFFFF;
  border: none;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  height: auto;
  line-height: 1;
}

.btn-copy::after {
  border: none;
}

/* 主题选择弹窗 */
.theme-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 0 env(safe-area-inset-bottom);
  z-index: 1001;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.theme-list {
  padding: 16rpx 32rpx 32rpx;
}

.theme-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.3s ease;
}

.theme-item.active {
  background: linear-gradient(135deg, #E5F9F7 0%, #D9F0EE 100%);
  border: 2rpx solid #07C160;
}

.theme-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.theme-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.theme-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.theme-desc {
  font-size: 24rpx;
  color: #999999;
}

.theme-check {
  font-size: 32rpx;
  color: #07C160;
  font-weight: bold;
  margin-left: 12rpx;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background: var(--color-bg-secondary);
  }

  .user-card {
    background: linear-gradient(135deg, #4A5A8A 0%, #5A3F7A 100%);
  }

  .menu-section,
  .menu-group {
    background: var(--color-bg-primary);
  }

  .menu-item {
    border-bottom-color: var(--color-border-light);
  }

  .menu-text,
  .contact-value {
    color: var(--color-text-primary);
  }

  .menu-value,
  .contact-label {
    color: var(--color-text-secondary);
  }

  .theme-modal,
  .contact-modal {
    background: var(--color-bg-primary);
  }

  .theme-item {
    background: var(--color-bg-secondary);
  }

  .theme-item.active {
    background: linear-gradient(135deg, #1E5552 0%, #1A4A47 100%);
    border-color: #1AC158;
  }

  .theme-name {
    color: var(--color-text-primary);
  }

  .theme-desc {
    color: var(--color-text-tertiary);
  }

  .version-text {
    color: var(--color-text-tertiary);
  }
}

