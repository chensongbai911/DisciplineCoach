<!--pages/user/index.wxml-->
<!-- 用户中心页 - 个人信息和设置 -->

<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <app-image class="user-avatar" src="{{userInfo.avatarUrl || '/assets/images/default-avatar.png'}}" size="120" radius="9999" fallbackText="🙂" mode="aspectFill" />
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '未登录'}}</text>
        <view class="user-stats">
          <text class="stat-item">累计 {{totalDays}} 天</text>
          <text class="stat-divider">·</text>
          <text class="stat-item">连续 {{streakDays}} 天</text>
        </view>
      </view>
      <view class="vip-badge" wx:if="{{memberStatus.isVip}}">
        <text class="vip-icon">👑</text>
        <text class="vip-text">VIP</text>
      </view>
    </view>

    <!-- 会员状态 -->
    <view class="member-section" wx:if="{{!memberStatus.isVip}}" bindtap="navigateToVip">
      <view class="member-prompt">
        <text class="prompt-icon">✨</text>
        <text class="prompt-text">升级会员，解锁更多功能</text>
      </view>
      <text class="member-arrow">›</text>
    </view>
    <view class="member-section vip" wx:else>
      <view class="member-prompt">
        <text class="prompt-icon">👑</text>
        <text class="prompt-text">会员有效期至 {{memberStatus.expireDate}}</text>
      </view>
      <text class="member-arrow" bindtap="navigateToVip">›</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/record/history">
        <view class="menu-item-left">
          <app-icon class="menu-icon" type="calendar" size="28" />
          <text class="menu-text">历史记录</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/statistics/analysis">
        <view class="menu-item-left">
          <app-icon class="menu-icon" type="chart" size="28" />
          <text class="menu-text">数据分析</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/user/achievements">
        <view class="menu-item-left">
          <app-icon class="menu-icon" type="trophy" size="28" />
          <text class="menu-text">我的成就</text>
        </view>
        <view class="menu-item-right">
          <text class="menu-badge">{{achievementCount}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/vip/index">
        <view class="menu-item-left">
          <app-icon class="menu-icon" type="vip" size="28" />
          <text class="menu-text">会员中心</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="handleReminder">
        <view class="menu-item-left">
          <app-icon class="menu-icon" type="bell" size="28" />
          <text class="menu-text">提醒设置</text>
        </view>
        <view class="menu-item-right">
          <switch checked="{{reminderEnabled}}" color="#07C160" bindchange="handleReminderToggle" catchtap="stopPropagation" />
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/feedback/index">
        <view class="menu-item-left">
          <text class="menu-icon">💬</text>
          <text class="menu-text">意见反馈</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/about/index">
        <view class="menu-item-left">
          <app-icon class="menu-icon" type="info" size="28" />
          <text class="menu-text">关于我们</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="handleContactUs">
        <view class="menu-item-left">
          <app-icon class="menu-icon" type="phone" size="28" />
          <text class="menu-text">联系我们</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">自律教练 v{{version}}</text>
  </view>
</view>

<!-- 联系方式弹窗 -->
<view class="modal-mask" wx:if="{{showContactModal}}" bindtap="closeContactModal"></view>
<view class="contact-modal" wx:if="{{showContactModal}}">
  <view class="modal-header">
    <text class="modal-title">联系我们</text>
    <text class="modal-close" bindtap="closeContactModal">✕</text>
  </view>
  <view class="contact-list">
    <view class="contact-item">
      <text class="contact-label">客服微信</text>
      <text class="contact-value">discipline_coach</text>
      <button class="btn-copy" size="mini" bindtap="handleCopyWechat">复制</button>
    </view>
    <view class="contact-item">
      <text class="contact-label">客服邮箱</text>
      <text class="contact-value">service@discipline.com</text>
      <button class="btn-copy" size="mini" bindtap="handleCopyEmail">复制</button>
    </view>
    <view class="contact-item">
      <text class="contact-label">工作时间</text>
      <text class="contact-value">周一至周五 9:00-18:00</text>
    </view>
  </view>
</view>
