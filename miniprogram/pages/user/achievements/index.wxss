/* pages/user/achievements/index.wxss */
page {
  background: #F7FAFC;
}

.achievements-page {
  min-height: 100vh;
  padding: 0 0 env(safe-area-inset-bottom);
}

/* 统计卡片 */
.stats-card {
  margin: 30rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.3);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.stats-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 进度环 */
.progress-ring {
  display: flex;
  justify-content: center;
  margin: 30rpx 0;
}

.progress-circle {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.progress-fill {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(
    #fff 0%,
    #fff var(--progress),
    rgba(255, 255, 255, 0.2) var(--progress),
    rgba(255, 255, 255, 0.2) 100%
  );
  animation: progressRotate 1s ease-out;
}

@keyframes progressRotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.progress-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.stats-desc {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 成就列表 */
.achievements-list {
  padding: 0 30rpx 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
  margin-bottom: 20rpx;
}

/* 成就网格 */
.achievement-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

.achievement-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.achievement-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.achievement-item.unlocked {
  border: 2rpx solid #667eea;
}

.achievement-item.locked {
  opacity: 0.6;
}

/* 成就图标 */
.achievement-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

.lock-icon {
  font-size: 40rpx;
}

/* 成就信息 */
.achievement-info {
  text-align: center;
  margin-bottom: 20rpx;
}

.achievement-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
  margin-bottom: 8rpx;
}

.achievement-desc {
  display: block;
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

/* 解锁时间 */
.achievement-date {
  text-align: center;
  font-size: 24rpx;
  color: #A0AEC0;
  margin-top: 10rpx;
}

/* 进度条 */
.achievement-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #E2E8F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  transition: width 0.5s ease;
}

.progress-label {
  font-size: 24rpx;
  color: #718096;
  min-width: 80rpx;
  text-align: right;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #718096;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #A0AEC0;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #A0AEC0;
}

/* 成就详情弹窗 */
.achievement-detail {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9998;
}

.detail-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  animation: fadeIn 0.3s ease;
}

.detail-card {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translate(-50%, -40%);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%);
  }
}

.detail-icon {
  text-align: center;
  margin-bottom: 30rpx;
}

.icon-large {
  font-size: 120rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #2D3748;
  text-align: center;
  margin-bottom: 16rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #718096;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 20rpx;
}

.detail-date {
  font-size: 24rpx;
  color: #A0AEC0;
  text-align: center;
  margin-bottom: 40rpx;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
}

.btn-share,
.btn-close {
  flex: 1;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-share {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-close {
  background: #F7FAFC;
  color: #718096;
}

.btn-share:active,
.btn-close:active {
  transform: scale(0.95);
}
