<!--pages/plan/index.wxml-->
<!-- 计划总览页 - 展示五大维度的计划配置 -->

<view class="container">
  <!-- 头部提示 -->
  <view class="tip-card">
    <app-image class="tip-icon" src="/assets/images/coach-happy.webp" size="80" radius="9999" fallbackText="🤖" />
    <view class="tip-content">
      <text class="tip-text">合理设定目标，逐步养成好习惯</text>
      <text class="tip-sub">建议从1-2个维度开始</text>
    </view>
  </view>

  <!-- 五大维度列表 -->
  <view class="dimension-list">
    <view
      class="dimension-card"
      wx:for="{{dimensions}}"
      wx:key="id"
      data-category="{{item.category}}"
      data-enabled="{{item.enabled}}"
      bindtap="handleDimensionTap"
    >
      <view class="dimension-header">
        <view class="dimension-left">
          <view class="dimension-icon" style="background: {{item.color}}20;">
            <text style="color: {{item.color}};">{{item.icon}}</text>
          </view>
          <view class="dimension-info">
            <text class="dimension-title">{{item.name}}</text>
            <text class="dimension-desc">{{item.description}}</text>
          </view>
        </view>
        <view class="dimension-right">
          <switch
            checked="{{item.enabled}}"
            color="{{item.color}}"
            bindchange="handleToggle"
            data-category="{{item.category}}"
            catchtap="handleSwitchTap"
          />
        </view>
      </view>

      <!-- 已配置的任务列表 -->
      <block wx:if="{{item.enabled && item.tasks.length > 0}}">
        <view class="task-preview">
          <view class="task-preview-item" wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id">
            <text class="task-preview-title">{{task.title}}</text>
            <text class="task-preview-target">{{task.targetDesc}}</text>
          </view>
        </view>
      </block>

      <!-- 空状态 - 未配置任务 -->
      <block wx:if="{{item.enabled && item.tasks.length === 0}}">
        <view class="empty-task" bindtap="handleAddTask" data-category="{{item.category}}">
          <text class="icon-add">+</text>
          <text class="empty-text">添加{{item.name}}任务</text>
        </view>
      </block>

      <!-- 配置按钮 - 已开启时显示 -->
      <block wx:if="{{item.enabled}}">
        <view class="dimension-footer">
          <button
            class="btn-text"
            size="mini"
            data-category="{{item.category}}"
            bindtap="handleEditTasks"
          >
            <text class="icon-edit">✏️</text> 编辑任务
          </button>
        </view>
      </block>
    </view>
  </view>

  <!-- 底部统计 -->
  <view class="bottom-stats">
    <text class="stats-text">已开启 {{enabledCount}} 个维度 · 共 {{totalTasks}} 个任务</text>
  </view>

  <!-- 快速添加按钮 - 当有已开启的维度时显示 -->
  <view class="quick-add-container" wx:if="{{enabledCount > 0}}">
    <button class="btn-add-task" bindtap="showDimensionPicker">
      <text class="btn-icon">🔹</text>
      <text class="btn-text">添加任务</text>
    </button>
  </view>

  <!-- 维度选择器 -->
  <view class="dimension-picker-mask" wx:if="{{showPicker}}" bindtap="hideDimensionPicker">
    <view class="dimension-picker" catchtap="stopPropagation">
      <view class="picker-header">
        <text class="picker-title">选择维度</text>
        <text class="picker-close" bindtap="hideDimensionPicker">✕</text>
      </view>
      <view class="picker-list">
        <view
          class="picker-item {{!item.enabled ? 'disabled' : ''}}"
          wx:for="{{dimensions}}"
          wx:key="id"
          data-category="{{item.category}}"
          bindtap="handlePickerSelect"
        >
          <view class="picker-item-icon" style="background: {{item.color}}20;">
            <text style="color: {{item.color}};">{{item.icon}}</text>
          </view>
          <view class="picker-item-info">
            <text class="picker-item-name">{{item.name}}</text>
            <text class="picker-item-count">{{item.tasks.length}} 个任务</text>
          </view>
          <text class="picker-item-arrow" wx:if="{{item.enabled}}">›</text>
          <text class="picker-item-tip" wx:else>未开启</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快速入门提示 -->
  <view class="guide-card" wx:if="{{showGuide}}">
    <view class="guide-header">
      <text class="guide-title">💡 快速入门</text>
      <text class="guide-close" bindtap="closeGuide">✕</text>
    </view>
    <view class="guide-steps">
      <view class="guide-step">
        <text class="step-num">1</text>
        <text class="step-text">选择你想培养的维度（建议1-2个）</text>
      </view>
      <view class="guide-step">
        <text class="step-num">2</text>
        <text class="step-text">为每个维度添加具体任务和目标</text>
      </view>
      <view class="guide-step">
        <text class="step-num">3</text>
        <text class="step-text">每天完成任务后在"今日"页打卡记录</text>
      </view>
    </view>
  </view>
</view>
