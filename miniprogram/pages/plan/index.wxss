/* pages/plan/index.wxss */

.container {
  padding-bottom: 120rpx;
}

/* 头部提示卡片 */
.tip-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin: 32rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #3182CE 100%);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 209, 197, 0.3);
}

.tip-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.tip-content {
  flex: 1;
}

.tip-text {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.tip-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

/* 维度列表 */
.dimension-list {
  padding: 0 32rpx;
}

.dimension-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

/* 未开启状态 */
.dimension-card[data-enabled="false"] {
  opacity: 0.6;
  background: #F7FAFC;
}

.dimension-card:active {
  transform: scale(0.98);
}

.dimension-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dimension-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.dimension-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.dimension-info {
  display: flex;
  flex-direction: column;
}

.dimension-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2D3748;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.dimension-desc {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
}

.dimension-right {
  margin-left: 16rpx;
}

/* 任务预览 */
.task-preview {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(226, 232, 240, 0.8);
}

.task-preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(247, 250, 252, 0.8);
}

.task-preview-item:last-child {
  border-bottom: none;
}

.task-preview-title {
  font-size: 30rpx;
  color: #2D3748;
  flex: 1;
  font-weight: 600;
}

.task-preview-target {
  font-size: 26rpx;
  color: #4FD1C5;
  margin-left: 16rpx;
  font-weight: 700;
}

/* 空状态 */
.empty-task {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 0;
  margin-top: 24rpx;
  border: 3rpx dashed #CBD5E0;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #F7FAFC 0%, #EDF2F7 100%);
  transition: all 0.3s ease;
}

.empty-task:active {
  background: linear-gradient(135deg, rgba(79, 209, 197, 0.08) 0%, rgba(49, 130, 206, 0.08) 100%);
  border-color: #4FD1C5;
}

.icon-add {
  font-size: 72rpx;
  color: #4FD1C5;
  margin-bottom: 16rpx;
  font-weight: 300;
}

.empty-text {
  font-size: 26rpx;
  color: #718096;
  font-weight: 600;
}

/* 维度底部操作区 */
.dimension-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #EEEEEE;
  display: flex;
  justify-content: flex-end;
}

.btn-text {
  background: transparent;
  color: #4FD1C5;
  font-size: 28rpx;
  padding: 0;
  height: auto;
  line-height: 1;
  border: none;
  display: flex;
  align-items: center;
  font-weight: 700;
  transition: all 0.3s ease;
}

.btn-text:active {
  color: #3182CE;
  transform: scale(0.95);
}

.btn-text::after {
  border: none;
}

.icon-edit {
  margin-right: 8rpx;
}

/* 底部统计 */
.bottom-stats {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 2rpx solid rgba(226, 232, 240, 0.8);
  text-align: center;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stats-text {
  font-size: 26rpx;
  color: #718096;
  font-weight: 600;
}

/* 快速入门引导 */
.guide-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-radius: 24rpx;
  border: 2rpx solid #FFB74D;
}

.guide-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #F57C00;
}

.guide-close {
  font-size: 32rpx;
  color: #F57C00;
  padding: 8rpx;
}

.guide-steps {
  padding-left: 16rpx;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.guide-step:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F57C00;
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  color: #E65100;
  line-height: 40rpx;
}
