/* pages/plan/plan-detail.wxss */

.container {
  padding-bottom: 120rpx;
}

/* 头部卡片 */
.header-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin: 32rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.dimension-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
  background: rgba(255, 255, 255, 0.2) !important;
}

.header-info {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 任务列表 */
.task-list {
  padding: 0 32rpx;
}

.task-item-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.task-item-card:active {
  transform: scale(0.98);
}

.task-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.task-item-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  flex: 1;
}

.task-item-actions {
  margin-left: 16rpx;
}

.action-icon {
  font-size: 36rpx;
  padding: 8rpx;
}

.task-item-body {
  padding-top: 16rpx;
  border-top: 2rpx solid #F7F8FA;
}

.task-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-meta:last-child {
  margin-bottom: 0;
}

.meta-label {
  font-size: 26rpx;
  color: #999999;
  margin-right: 8rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #333333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-image {
  width: 320rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
}

/* 底部操作区 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.icon-add {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 表单弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.modal-form {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 92vw;
  max-width: 650rpx;
  max-height: 88vh;
  background: #FFFFFF;
  border-radius: 32rpx;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  animation: scaleIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 2rpx solid rgba(226, 232, 240, 0.8);
  flex-shrink: 0;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #2D3748;
  letter-spacing: 0.5rpx;
}

.modal-close {
  font-size: 44rpx;
  color: #A0AEC0;
  padding: 8rpx;
  line-height: 1;
  transition: all 0.3s ease;
}

.modal-close:active {
  color: #718096;
  transform: scale(0.9);
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
  border-top: 2rpx solid rgba(226, 232, 240, 0.8);
  flex-shrink: 0;
  background: #FAFBFC;
}

/* 表单样式 */
.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 30rpx;
  color: #2D3748;
  margin-bottom: 16rpx;
  font-weight: 700;
  letter-spacing: 0.3rpx;
}

.required {
  color: #FF6B6B;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-base {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #2D3748;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.input-base:focus {
  background: #FFFFFF;
  border-color: #4FD1C5;
}

.textarea-base {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #2D3748;
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.textarea-base:focus {
  background: #FFFFFF;
  border-color: #4FD1C5;
}

/* 类型选项 */
.type-options {
  display: flex;
  gap: 12rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 12rpx;
  background: #F7FAFC;
  border: 3rpx solid #E2E8F0;
  border-radius: 18rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-option:active {
  transform: scale(0.96);
}

.type-option.active {
  background: linear-gradient(135deg, rgba(79, 209, 197, 0.08) 0%, rgba(49, 130, 206, 0.08) 100%);
  border-color: #4FD1C5;
  box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.15);
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
  transition: transform 0.3s ease;
}

.type-option.active .type-icon {
  transform: scale(1.1);
}

.type-text {
  font-size: 26rpx;
  color: #718096;
  font-weight: 600;
}

.type-option.active .type-text {
  color: #3182CE;
  font-weight: 700;
}

/* 输入组 */
.input-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.flex-1 {
  flex: 1;
}

.picker-unit {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 88rpx;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
}

.picker-unit:active {
  border-color: #4FD1C5;
  background: #FFFFFF;
}

.picker-text {
  font-size: 30rpx;
  color: #2D3748;
  font-weight: 600;
}

.unit-input {
  width: 120rpx;
  text-align: center;
}

/* 时间选择 */
.time-range {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.time-picker {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #2D3748;
  font-weight: 600;
  transition: all 0.3s ease;
}

.time-picker:active {
  border-color: #4FD1C5;
  background: #FFFFFF;
}

.time-divider {
  font-size: 26rpx;
  color: #A0AEC0;
  font-weight: 600;
}

.time-picker-full {
  height: 88rpx;
  padding: 0 24rpx;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
}

.time-picker-full:active {
  border-color: #4FD1C5;
  background: #FFFFFF;
}

.picker-label {
  font-size: 30rpx;
  color: #718096;
  font-weight: 600;
}

.picker-value {
  font-size: 30rpx;
  color: #2D3748;
  font-weight: 700;
}

.reminder-time {
  margin-top: 16rpx;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #4FD1C5 0%, #3182CE 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  box-shadow: 0 6rpx 16rpx rgba(79, 209, 197, 0.3);
  transition: all 0.3s ease;
  letter-spacing: 1rpx;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.25);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #FFFFFF;
  color: #718096;
  border: 2rpx solid #E2E8F0;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  transition: all 0.3s ease;
  letter-spacing: 1rpx;
}

.btn-secondary:active {
  transform: scale(0.98);
  background: #F7FAFC;
  border-color: #CBD5E0;
}

.btn-secondary::after {
  border: none;
}

.btn-block {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ml-2 {
  margin-left: 16rpx;
}
