/* pages/record/day-detail.wxss */

.container {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* 日历区域 */
.calendar-section {
  margin-bottom: 32rpx;
}

/* 日期头部 */
.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-info {
  display: flex;
  align-items: baseline;
}

.date-main {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-right: 16rpx;
}

.date-weekday {
  font-size: 28rpx;
  color: #666666;
}

.date-summary {
  padding: 8rpx 16rpx;
  background: #E8F5E9;
  border-radius: 16rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 500;
}

/* 完成度卡片 */
.progress-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 28rpx;
  color: #666666;
}

.progress-percent {
  font-size: 36rpx;
  font-weight: 700;
  color: #07C160;
}

.progress-bar {
  height: 16rpx;
  background: #F7F8FA;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s;
}

/* 记录列表 */
.record-list {
  margin-bottom: 32rpx;
}

.record-group {
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.group-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.group-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
}

.group-count {
  font-size: 24rpx;
  color: #999999;
}

.record-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.record-info {
  flex: 1;
  margin-right: 16rpx;
}

.record-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.record-detail {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.record-actual {
  color: #07C160;
  font-weight: 500;
}

.record-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.record-status.completed {
  background: #E8F5E9;
}

.record-status.incomplete {
  background: #F7F8FA;
}

.status-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.record-status.completed .status-icon {
  color: #07C160;
}

.record-status.incomplete .status-icon {
  color: #CCCCCC;
}

.status-text {
  font-size: 20rpx;
}

.record-status.completed .status-text {
  color: #07C160;
}

.record-status.incomplete .status-text {
  color: #999999;
}

.record-remark {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F7F8FA;
}

.remark-label {
  font-size: 24rpx;
  color: #999999;
}

.remark-text {
  font-size: 24rpx;
  color: #666666;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F7F8FA;
}

.btn-text-small {
  background: transparent;
  color: #07C160;
  font-size: 24rpx;
  padding: 0 16rpx;
  height: auto;
  line-height: 1;
  border: none;
}

.btn-text-small::after {
  border: none;
}

.text-danger {
  color: #FF6B6B !important;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  width: 320rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 底部总结 */
.summary-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.modal-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.modal-body {
  margin-bottom: 32rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.input-base {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.textarea-base {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
}

.btn-primary {
  background: #07C160;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #F7F8FA;
  color: #666666;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}

.btn-secondary::after {
  border: none;
}

.flex-1 {
  flex: 1;
}

.mr-sm {
  margin-right: 16rpx;
}
