/* pages/about/index.wxss */

.container {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  margin-bottom: 32rpx;
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.app-version {
  font-size: 24rpx;
  color: #999999;
  padding: 8rpx 24rpx;
  background: #EEEEEE;
  border-radius: 24rpx;
}

/* 应用介绍 */
.intro-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.intro-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* 功能亮点 */
.features-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.feature-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.feature-info {
  flex: 1;
}

.feature-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

/* 联系我们 */
.contact-section {
  margin-bottom: 32rpx;
}

.contact-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
  transition: all 0.3s;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item:active {
  background: #F7F8FA;
  margin: 0 -32rpx;
  padding: 32rpx;
}

.contact-left {
  display: flex;
  align-items: center;
}

.contact-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.contact-label {
  font-size: 28rpx;
  color: #333333;
}

.contact-right {
  display: flex;
  align-items: center;
}

.contact-value {
  font-size: 24rpx;
  color: #666666;
  margin-right: 16rpx;
}

.contact-action {
  font-size: 24rpx;
  color: #07C160;
  padding: 8rpx 16rpx;
  background: #E8F5E9;
  border-radius: 8rpx;
}

/* 相关链接 */
.links-section {
  margin-bottom: 32rpx;
}

.link-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.link-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
  transition: all 0.3s;
}

.link-item:last-child {
  border-bottom: none;
}

.link-item:active {
  background: #F7F8FA;
  margin: 0 -32rpx;
  padding: 32rpx;
}

.link-text {
  font-size: 28rpx;
  color: #333333;
}

.link-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 版权信息 */
.copyright-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.copyright-text {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}
