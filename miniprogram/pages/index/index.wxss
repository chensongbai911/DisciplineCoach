/* index.wxss */
@import "../../styles/skeleton.wxss";

page {
  background: linear-gradient(180deg, #4FD1C5 0%, #63B3ED 100%);
  min-height: 100vh;
}

.page-container {
  position: relative;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 离线提示横幅 */
.offline-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF5252 100%);
  color: var(--color-text-white, #FFFFFF);  /* 使用CSS变量 */
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  z-index: 1000;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.2);
  animation: slideDown 0.3s ease-out;
}

.icon-offline {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.offline-text {
  opacity: 0.95;
}

@keyframes slideDown {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}


.page-container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, rgba(79, 209, 197, 0.2) 0%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

/* 小教练区域 - 优化设计 */
.coach-section {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
  max-width: 100%;
  border-radius: 24rpx;
  /* 移除半透明背景，保持透明 */
}

/* 小屏幕 (< 375px) 时堆叠 */
@media (max-width: 374px) {
  .coach-section {
    flex-direction: column;
    align-items: center;
    padding: 28rpx 20rpx;
    gap: 12rpx;
  }
}

/* 中等屏幕 (375-414px) */
@media (min-width: 375px) and (max-width: 414px) {
  .coach-section {
    padding: 32rpx 24rpx;
  }
}

/* 大屏幕 (> 414px) */
@media (min-width: 415px) {
  .coach-section {
    padding: 40rpx 32rpx 32rpx;
    gap: 20rpx;
  }
}

/* 右侧内容容器 */
.coach-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
  /* 防止内容溢出 */
}

@media (max-width: 374px) {
  .coach-content {
    width: 100%;
    gap: 10rpx;
  }
}

/* 操作按钮行 */
.coach-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  width: 100%;
}

@media (min-width: 415px) {
  .coach-actions {
    gap: 12rpx;
  }
}

/* 动作按钮组 */
.action-buttons {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  width: 100%;
}

@media (min-width: 415px) {
  .action-buttons {
    gap: 12rpx;
  }
}

/* 提醒时间显示文本 */
.reminder-info {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #787878);  /* WCAG AA 合规 */
  padding: 0 4rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

@media (max-width: 374px) {
  .reminder-info {
    font-size: 20rpx;
  }
}

/* 旧的 reminder-row 保持向后兼容（如果有其他地方使用） */
.reminder-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

@media (max-width: 374px) {
  .reminder-row {
    gap: 8rpx;
  }
}

@media (min-width: 415px) {
  .reminder-row {
    gap: 16rpx;
  }
}

.reminder-text {
  font-size: 24rpx;
  color: var(--color-text-primary, #333333);  /* 统一主要文本色 */
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 500;
}

@media (max-width: 374px) {
  .reminder-text {
    font-size: 22rpx;
  }
}

/* 提醒操作区容器 */
.reminder-actions,
.reminder-enabled {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  flex-wrap: wrap;
}

@media (max-width: 374px) {
  .reminder-actions,
  .reminder-enabled {
    gap: 8rpx;
  }
}

/* 订阅和轮廓按钮 */
.btn-subscribe,
.btn-subscribe-outline {
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 9999rpx;
  transition: all 0.3s ease;
  user-select: none;
  white-space: nowrap;
  flex-shrink: 0;
  border: none;
  cursor: pointer;
}

/* 响应式按钮大小 */
@media (max-width: 374px) {
  .btn-subscribe,
  .btn-subscribe-outline {
    font-size: 22rpx;
    padding: 12rpx 20rpx;
  }
}

@media (max-height: 600px) {
  .btn-subscribe,
  .btn-subscribe-outline {
    padding: 10rpx 20rpx;
    font-size: 22rpx;
  }
}

/* 主要按钮 */
.btn-subscribe {
  color: #fff;
  background: linear-gradient(135deg, #4FD1C5 0%, #38B2AC 100%);
  box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.3);
}

.btn-subscribe:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(79, 209, 197, 0.4);
}

.btn-subscribe:disabled {
  opacity: 0.6;
  box-shadow: none;
}

/* 轮廓按钮 */
.btn-subscribe-outline {
  color: #4A5568;
  border: 2rpx solid #CBD5E0;
  background: rgba(255, 255, 255, 0.6);
}

.btn-subscribe-outline:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.8);
  border-color: #A0AEC0;
}

.btn-subscribe-outline:disabled {
  opacity: 0.5;
  border-color: #E2E8F0;
}

/* 头像 */
.coach-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(79, 209, 197, 0.5);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  animation: float 3s ease-in-out infinite, breathe 4s ease-in-out infinite;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.coach-avatar:active {
  transform: scale(0.92);
  box-shadow: 0 6rpx 18rpx rgba(79, 209, 197, 0.6);
}

/* 响应式头像大小 */
@media (min-width: 415px) {
  .coach-avatar {
    width: 120rpx;
    height: 120rpx;
    flex-shrink: 0;
  }
}

/* 气泡消息 */
.coach-bubble {
  flex: 1;
  min-width: 200rpx;
  background: #FFFFFF;  /* 统一为纯白色 */
  backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 209, 197, 0.12);
  position: relative;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  animation: slideInRight 0.5s ease-out;
}

/* 响应式气泡内边距 */
@media (max-width: 374px) {
  .coach-bubble {
    padding: 24rpx 28rpx;
    min-width: auto;
    width: 100%;
  }
}

@media (min-width: 415px) {
  .coach-bubble {
    padding: 32rpx 36rpx;
  }
}

/* 气泡箭头 - 仅在非堆叠时显示 */
@media (min-width: 375px) {
  .coach-bubble::before {
    content: '';
    position: absolute;
    left: -16rpx;
    top: calc(50% - 16rpx);
    width: 0;
    height: 0;
    border-top: 16rpx solid transparent;
    border-bottom: 16rpx solid transparent;
    border-right: 16rpx solid #FFFFFF;  /* 修正为纯白色 */
    filter: drop-shadow(-2rpx 0 4rpx rgba(79, 209, 197, 0.1));
  }
}

/* 气泡箭头隐藏在小屏幕 */
@media (max-width: 374px) {
  .coach-bubble::before {
    display: none;
  }
}

/* 消息文本 */
.coach-message {
  font-size: 28rpx;
  color: #2D3748;
  line-height: 1.8;
  font-weight: 500;
  word-break: break-word;
  /* 增加行高，更宽松的显示 */
}

/* 响应式文字大小 */
@media (max-width: 374px) {
  .coach-message {
    font-size: 26rpx;
    line-height: 1.6;
  }
}

@media (min-width: 415px) {
  .coach-message {
    font-size: 30rpx;
    line-height: 1.9;
  }
}

/* 今日概览卡片 */
.overview-card {
  margin: 0 32rpx 32rpx;
  background: #FFFFFF !important;  /* 统一为纯白色 */
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 209, 197, 0.12);
  animation: fadeInScale 0.6s ease-out;
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.overview-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(79, 209, 197, 0.08) 0%, rgba(99, 179, 237, 0.08) 100%);
  border-radius: 50%;
  pointer-events: none;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.overview-title {
  font-size: 38rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #4FD1C5 0%, #3182CE 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 0.5rpx;
}

.overview-date {
  font-size: 24rpx;
  color: var(--color-text-tertiary, #787878);  /* WCAG AA 合规 */
  background: rgba(79, 209, 197, 0.15);
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  font-weight: 600;
}

.overview-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 70rpx;
  height: 70rpx;
  background: radial-gradient(circle, rgba(79, 209, 197, 0.12) 0%, transparent 70%);
  border-radius: 50%;
  z-index: -1;
}

.stat-value {
  margin-bottom: 8rpx;
  font-weight: 800;
  font-size: 56rpx !important;
  text-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.3);
  font-family: -apple-system, "SF Pro Display", "PingFang SC", sans-serif;
  letter-spacing: -1rpx;
}

.stat-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary, #787878);  /* WCAG AA 合规 */
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(79, 209, 197, 0.25) 50%, transparent 100%);
}

/* 进度条区域 */
.progress-section {
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(79, 209, 197, 0.15);
}

.progress-text {
  font-size: 24rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #3182CE 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-top: 12rpx;
  display: block;
  text-align: right;
  font-weight: 700;
}

/* 任务列表 */
.task-list {
  margin-bottom: 120rpx;
  padding: 0 32rpx;
}

.checkin-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 36rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #3182CE 100%);
  color: var(--color-text-white, #FFFFFF);  /* 使用CSS变量 */
  font-size: 30rpx;
  border-radius: 34rpx;
  font-weight: 700;
  transition: all 0.3s;
  box-shadow: 0 6rpx 16rpx rgba(79, 209, 197, 0.4);
  position: relative;
  overflow: visible;
  letter-spacing: 1rpx;
}

/* 按钮脉冲动画 */
.checkin-btn::after {
  content: '';
  position: absolute;
  inset: -4rpx;
  border: 3rpx solid rgba(79, 209, 197, 0.6);
  border-radius: 38rpx;
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0;
    transform: scale(1.15);
  }
}

.checkin-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.checkin-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.35);
}

.checkin-btn:active::before {
  width: 200rpx;
  height: 200rpx;
}

.task-card {
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  animation: slideInUp 0.4s ease-out backwards;
}

/* 为不同的卡片添加延迟 */
.task-card:nth-child(1) { animation-delay: 0.1s; }
.task-card:nth-child(2) { animation-delay: 0.15s; }
.task-card:nth-child(3) { animation-delay: 0.2s; }
.task-card:nth-child(4) { animation-delay: 0.25s; }
.task-card:nth-child(5) { animation-delay: 0.3s; }

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.task-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--card-color-start), var(--card-color-end));
  transition: width 0.3s ease;
  border-radius: 0 4rpx 4rpx 0;
}

.task-card[data-category="运动"] {
  --card-color-start: #FF6B6B;
  --card-color-end: #FF5252;
}

.task-card[data-category="饮食"] {
  --card-color-start: #38B2AC;
  --card-color-end: #1E9B96;
}

.task-card[data-category="睡眠"] {
  --card-color-start: #9F7AEA;
  --card-color-end: #7B5FD1;
}

.task-card[data-category="阅读"] {
  --card-color-start: #F6AD55;
  --card-color-end: #E89239;
}

.task-card[data-category="学习"] {
  --card-color-start: #4299E1;
  --card-color-end: #2E7EC9;
}

.task-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-card-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.task-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, var(--card-color-start), var(--card-color-end));
  opacity: 1;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  transition: all 0.3s ease;
}

.task-icon::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  z-index: -1;
}

.task-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text-primary, #333333);  /* 统一主要文本色 */
  letter-spacing: 0.5rpx;
}

.task-card-right {
  display: flex;
  align-items: center;
}

.task-status {
  font-size: 26rpx;
  color: var(--color-text-tertiary, #787878);  /* WCAG AA 合规 */
  margin-right: 16rpx;
  font-weight: 700;
  font-family: -apple-system, "SF Pro Display", "PingFang SC", sans-serif;
}

.icon-arrow {
  font-size: 20rpx;
  color: var(--color-text-tertiary, #787878);  /* WCAG AA 合规 */
  transition: transform 0.3s;
}

.icon-arrow.expanded {
  transform: rotate(180deg);
}

/* 任务卡片内容 */
.task-card-body {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid rgba(226, 232, 240, 0.8);
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    max-height: 0;
  }
  to {
    opacity: 1;
    max-height: 1000rpx;
  }
}

.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(226, 232, 240, 0.8);
  transition: all 0.3s ease;
  position: relative;
  background: #ffffff;  /* 确保有白色背景遮盖后面的按钮 */
}

/* 长按反馈效果 */
.task-item:active {
  background: rgba(79, 209, 197, 0.08);
  transform: scale(0.98);
  border-radius: 16rpx;
  margin: 0 -16rpx;
  padding: 24rpx 16rpx;
}

/* 长按提示动画 */
.task-item::after {
  content: '长按快速打卡';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  color: #4FD1C5;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.task-item:active::after {
  opacity: 0.6;
  animation: fadeInOut 0.8s ease;
}

@keyframes fadeInOut {
  0%, 100% { opacity: 0; }
  50% { opacity: 0.8; }
}

.task-item:last-child {
  border-bottom: none;
}

.task-item-left {
  flex: 1;
  margin-right: 16rpx;
}

.task-item-title {
  font-size: 30rpx;
  color: var(--color-text-primary, #333333);  /* 统一主要文本色 */
  display: block;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.task-item-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary, #787878);  /* WCAG AA 合规 */
  display: block;
  font-weight: 500;
}

.task-item-right {
  flex-shrink: 0;
}

.task-completed {
  display: flex;
  align-items: center;
  color: #38B2AC;
  font-weight: 600;
}

.icon-check {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.completed-text {
  font-size: 26rpx;
  font-weight: 600;
}

.empty-tasks {
  padding: 48rpx 0;
  text-align: center;
}

.empty-tasks .empty-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary, #787878);  /* WCAG AA 合规 */
  font-weight: 500;
}

/* 底部操作区 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx);
  box-shadow: 0 -8rpx 32rpx rgba(79, 209, 197, 0.1);
  border-top: 2rpx solid rgba(79, 209, 197, 0.15);
  z-index: 100;
  display: flex;
  gap: 16rpx;
}

.bottom-action button {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.btn-outline {
  background: #FFFFFF;
  color: #4FD1C5;
  border: 2rpx solid #4FD1C5;
}

.btn-outline::after {
  border: none;
}

.btn-outline:active {
  background: rgba(79, 209, 197, 0.1);
  transform: scale(0.98);
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: 400;
}

/* FAB 悬浮按钮容器 */
.fab-container {
  position: fixed;
  right: 30rpx;
  bottom: calc(env(safe-area-inset-bottom) + 180rpx);  /* 调整位置，避免与底部按钮重叠 */
  z-index: 999;
}

/* 浮动添加按钮 */
.fab {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  touch-action: manipulation;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 209, 197, 0.4);
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  transition: all 0.3s ease;
}

.fab:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.3);
}

.fab-active {
  background: linear-gradient(135deg, #38B2AC 0%, #2C7A7B 100%);
  transform: rotate(45deg);
}

/* FAB 菜单 */
.fab-menu {
  position: absolute;
  bottom: 120rpx;
  right: 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15), 0 0 0 1rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  animation: fabMenuSlideUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  min-width: 340rpx;
}

@keyframes fabMenuSlideUp {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.95);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.fab-menu-item {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: all 0.2s ease;
  position: relative;
  cursor: pointer;
}

.fab-menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 80rpx;
  right: 24rpx;
  height: 1rpx;
  background: linear-gradient(90deg, #E2E8F0 0%, transparent 100%);
}

.fab-menu-item:active {
  background: linear-gradient(90deg, rgba(79, 209, 197, 0.08) 0%, rgba(79, 209, 197, 0.02) 100%);
  transform: scale(0.98);
}

/* FAB 菜单图标 */
.fab-menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.fab-menu-item:active .fab-menu-icon {
  transform: scale(1.1);
}

.icon-check {
  background: linear-gradient(135deg, #48BB78 0%, #38A169 100%);
  color: #fff;
}

.icon-add {
  background: linear-gradient(135deg, #4FD1C5 0%, #38B2AC 100%);
  color: #fff;
}

/* FAB 菜单内容 */
.fab-menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.fab-menu-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
  line-height: 1.4;
}

.fab-menu-desc {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.4;
}

@keyframes fabPulse {
  0%, 100% {
    box-shadow: 0 12rpx 32rpx rgba(79, 209, 197, 0.4);
  }
  50% {
    box-shadow: 0 12rpx 40rpx rgba(79, 209, 197, 0.6), 0 0 0 8rpx rgba(79, 209, 197, 0.1);
  }
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4rpx);
  z-index: 999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  max-height: 85vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #F7F8FA 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: 32rpx;
  z-index: 1000;
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  box-sizing: border-box;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  padding-right: 64rpx;
  border-bottom: 2rpx solid #EEEEEE;
  position: relative;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  flex: 1;
}

.btn-close {
  position: absolute;
  top: -8rpx;
  right: 0;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  width: 64rpx !important;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
  z-index: 10;
}

.btn-close::after {
  border: none;
}

.modal-body {
  margin-bottom: 32rpx;
  overflow-y: auto;
  overflow-x: hidden;
  flex: 1;
  -webkit-overflow-scrolling: touch;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

/* 日期选择器样式 */
.date-picker {
  width: 100%;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

.date-picker::after {
  content: ' 📅';
  font-size: 32rpx;
  margin-left: 12rpx;
}

/* 高亮今天 */
.date-today {
  background: linear-gradient(135deg, #4FD1C5 0%, #38B2AC 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(79, 209, 197, 0.4);
}

.date-today::after {
  content: ' ✨';
}

.input-base {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.textarea-base {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding-top: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 2rpx solid #EEEEEE;
  flex-shrink: 0;
}

.modal-btn {
  flex: 1;
  height: 88rpx !important;
  width: auto !important;
  font-size: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none !important;
}

.modal-btn::after {
  border: none;
}

/* 成功反馈动画 */
.success-feedback {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 9999;
  text-align: center;
  animation: bounceIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes bounceIn {
  0% {
    transform: translate(-50%, -50%) scale(0) rotate(-180deg);
    opacity: 0;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.15) rotate(5deg);
  }
  100% {
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
    opacity: 1;
  }
}

.coach-avatar-large {
  width: 160rpx;
  height: 160rpx;
  display: block;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  box-shadow: 0 16rpx 48rpx rgba(79, 209, 197, 0.5);
  border: 6rpx solid rgba(255, 255, 255, 0.95);
  animation: wiggle 1s ease-in-out infinite;
}

@keyframes wiggle {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}

.success-feedback .bubble {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(247, 248, 250, 0.98) 100%);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(79, 209, 197, 0.25);
  padding: 28rpx 44rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 209, 197, 0.2);
  font-size: 34rpx;
  color: #2D3748;
  font-weight: 700;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 64rpx;
  margin: 0 32rpx;
  background: #FFFFFF;  /* 统一为纯白色 */
  backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(79, 209, 197, 0.1);
}

.empty-state .empty-icon {
  margin-bottom: 32rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #A0AEC0;
  font-weight: 500;
  margin-bottom: 32rpx;
}

/* 底部快速添加任务按钮 */
.quick-add-container {
  position: fixed;
  bottom: 90rpx;
  bottom: calc(90rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  z-index: 200;
}

.btn-add-task {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  border-radius: 60rpx;
  padding: 28rpx 64rpx;
  min-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  line-height: 1.2;
  touch-action: manipulation;
  position: relative;
  overflow: hidden;
}

.btn-add-task::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.btn-add-task:active::before {
  width: 300%;
  height: 300%;
}

.btn-add-task::after {
  border: none;
}

.btn-add-task:active {
  transform: scale(0.95);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-add-task .btn-icon {
  font-size: 36rpx;
  line-height: 1;
}

.btn-add-task .btn-text {
  font-size: 32rpx;
  line-height: 1;
}
