/* index.wxss */
page {
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.page-container {
  position: relative;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page-container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, rgba(102, 126, 234, 0.3) 0%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

/* 小教练区域 */
.coach-section {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.coach-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.coach-bubble {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  position: relative;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.coach-bubble::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 24rpx;
  width: 0;
  height: 0;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-right: 16rpx solid rgba(255, 255, 255, 0.95);
  filter: drop-shadow(-2rpx 0 4rpx rgba(0, 0, 0, 0.05));
}

.coach-message {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  font-weight: 500;
}

/* 今日概览卡片 */
.overview-card {
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.95) !important;
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  position: relative;
  overflow: hidden;
}

.overview-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 50%;
  pointer-events: none;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.overview-title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.overview-date {
  font-size: 24rpx;
  color: #999999;
  background: rgba(102, 126, 234, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.overview-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 60rpx;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  z-index: -1;
}

.stat-value {
  margin-bottom: 8rpx;
  font-weight: 700;
  font-size: 48rpx !important;
  text-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.2);
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(102, 126, 234, 0.2) 50%, transparent 100%);
}

/* 进度条区域 */
.progress-section {
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(102, 126, 234, 0.1);
}

.progress-text {
  font-size: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-top: 12rpx;
  display: block;
  text-align: right;
  font-weight: 600;
}

/* 任务列表 */
.task-list {
  margin-bottom: 120rpx;
}

.task-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #07C160;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.checkin-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 32rpx;
  font-weight: 600;
  transition: all 0.3s;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
  position: relative;
  overflow: hidden;
}

.checkin-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.checkin-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.checkin-btn:active::before {
  width: 200rpx;
  height: 200rpx;
}

.task-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.task-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--card-color-start), var(--card-color-end));
  transition: width 0.3s ease;
}

.task-card[data-category="运动"] {
  --card-color-start: #FF6B6B;
  --card-color-end: #FF8E53;
}

.task-card[data-category="饮食"] {
  --card-color-start: #4ECDC4;
  --card-color-end: #44A08D;
}

.task-card[data-category="睡眠"] {
  --card-color-start: #9B59B6;
  --card-color-end: #8E44AD;
}

.task-card[data-category="阅读"] {
  --card-color-start: #F39C12;
  --card-color-end: #F1C40F;
}

.task-card[data-category="学习"] {
  --card-color-start: #3498DB;
  --card-color-end: #2980B9;
}

.task-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-card-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.task-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
  background: linear-gradient(135deg, var(--card-color-start), var(--card-color-end));
  opacity: 0.15;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.task-icon::after {
  content: '';
  position: absolute;
  inset: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  z-index: -1;
}

.task-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.task-card-right {
  display: flex;
  align-items: center;
}

.task-status {
  font-size: 24rpx;
  color: #999999;
  margin-right: 16rpx;
}

.icon-arrow {
  font-size: 20rpx;
  color: #999999;
  transition: transform 0.3s;
}

.icon-arrow.expanded {
  transform: rotate(180deg);
}

/* 任务卡片内容 */
.task-card-body {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #EEEEEE;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    max-height: 0;
  }
  to {
    opacity: 1;
    max-height: 1000rpx;
  }
}

.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item-left {
  flex: 1;
  margin-right: 16rpx;
}

.task-item-title {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.task-item-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.task-item-right {
  flex-shrink: 0;
}

.task-completed {
  display: flex;
  align-items: center;
  color: #07C160;
}

.icon-check {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.completed-text {
  font-size: 24rpx;
}

.empty-tasks {
  padding: 40rpx 0;
  text-align: center;
}

.empty-tasks .empty-text {
  font-size: 24rpx;
  color: #999999;
}

/* 底部操作区 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  border-top: 2rpx solid rgba(102, 126, 234, 0.1);
  z-index: 100;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4rpx);
  z-index: 999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(180deg, #FFFFFF 0%, #F7F8FA 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  flex: 1;
}

.btn-close {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999999;
  line-height: 1;
  flex-shrink: 0;
}

.btn-close::after {
  border: none;
}

.modal-body {
  margin-bottom: 32rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.input-base {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.textarea-base {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #EEEEEE;
}

.modal-btn {
  flex: 1;
  height: 88rpx !important;
  width: auto !important;
  font-size: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none !important;
}

.modal-btn::after {
  border: none;
}

/* 成功反馈动画 */
.success-feedback {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 9999;
  text-align: center;
  animation: bounceIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes bounceIn {
  0% {
    transform: translate(-50%, -50%) scale(0) rotate(-180deg);
    opacity: 0;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.15) rotate(5deg);
  }
  100% {
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
    opacity: 1;
  }
}

.coach-avatar-large {
  width: 160rpx;
  height: 160rpx;
  display: block;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.5);
  border: 6rpx solid rgba(255, 255, 255, 0.95);
  animation: wiggle 1s ease-in-out infinite;
}

@keyframes wiggle {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}

.success-feedback .bubble {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(247, 248, 250, 0.98) 100%);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(102, 126, 234, 0.2);
  padding: 24rpx 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}
