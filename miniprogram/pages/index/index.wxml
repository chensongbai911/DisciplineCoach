<!--index.wxml-->
<view class="page-container">
  <!-- 离线提示横幅 -->
  <view class="offline-banner" wx:if="{{!isOnline}}">
    <text class="icon-offline">📡</text>
    <text class="offline-text">当前离线，显示为缓存数据</text>
  </view>

  <!-- 骨架屏加载状态 -->
  <view class="skeleton-container" wx:if="{{isLoading}}">
    <!-- 小教练区域骨架 -->
    <view class="skeleton-coach">
      <view class="skeleton-avatar skeleton-shimmer"></view>
      <view class="skeleton-bubble skeleton-shimmer"></view>
    </view>

    <!-- 概览卡片骨架 -->
    <view class="skeleton-card skeleton-shimmer">
      <view class="skeleton-title"></view>
      <view class="skeleton-stats">
        <view class="skeleton-stat" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>
      <view class="skeleton-progress"></view>
    </view>

    <!-- 任务卡片骨架 -->
    <view class="skeleton-task-card skeleton-shimmer" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-task-header"></view>
      <view class="skeleton-task-content"></view>
    </view>
  </view>

  <!-- 实际内容 -->
  <view class="content-container" wx:else>
    <!-- 小教练区域 -->
    <view class="coach-section">
      <app-image class="coach-avatar" src="/assets/images/coach-happy.png" size="120" radius="9999" fallbackText="🤖" />
      <view class="coach-bubble">
        <text class="coach-message">{{coachMessage}}</text>
      </view>
    </view>

    <!-- 今日概览卡片 -->
    <view class="overview-card card">
    <view class="overview-header">
      <text class="overview-title">今日概览</text>
      <text class="overview-date">{{currentDate}}</text>
    </view>

    <view class="overview-stats">
      <view class="stat-item">
        <text class="stat-value text-number-md text-success">{{completedTasks}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value text-number-md">{{totalTasks}}</text>
        <text class="stat-label">总任务</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value text-number-md text-warning">{{streakDays}}</text>
        <text class="stat-label">连续天数</text>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-section">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPercent}}%"></view>
      </view>
      <text class="progress-text">完成度 {{progressPercent}}%</text>
    </view>
    </view>

    <!-- 任务列表 -->
    <view class="task-list">
    <block wx:for="{{dimensions}}" wx:key="category">
      <view class="task-card" data-category="{{item.category}}">
        <!-- 卡片头部 -->
        <view class="task-card-header" bindtap="toggleCard" data-index="{{index}}">
          <view class="task-card-left">
            <view class="task-icon {{item.categoryClass}}">{{item.icon}}</view>
            <text class="task-title">{{item.name}}</text>
          </view>
          <view class="task-card-right">
            <text class="task-status">{{item.completedCount}}/{{item.totalCount}}</text>
            <app-icon class="icon-arrow {{item.expanded ? 'expanded' : ''}}" type="arrow-down" size="20" />
          </view>
        </view>

        <!-- 卡片内容 -->
        <view class="task-card-body" wx:if="{{item.expanded}}">
          <block wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id">
            <view
              class="task-item"
              bindlongpress="handleLongPress"
              data-task-id="{{task.id}}"
              data-task-title="{{task.title}}"
              data-task-type="{{task.type}}"
              data-task-unit="{{task.unit}}"
              data-task-target-value="{{task.targetValue}}"
              data-task-completed="{{task.completed}}">
              <view class="task-item-left">
                <text class="task-item-title">{{task.title}}</text>
                <text class="task-item-desc">目标: {{task.targetText}}</text>
              </view>
              <view class="task-item-right">
                <view
                  wx:if="{{!task.completed}}"
                  class="checkin-btn"
                  bindtap="handleCheckin"
                  data-task-id="{{task.id}}"
                  data-task-title="{{task.title}}"
                  data-task-type="{{task.type}}"
                  data-task-unit="{{task.unit}}"
                  data-task-target-value="{{task.targetValue}}">
                  打卡
                </view>
                <view wx:else class="task-completed">
                  <app-icon class="icon-check" type="check" size="32" />
                  <text class="completed-text">已完成</text>
                </view>
              </view>
            </view>
          </block>

          <!-- 空状态 -->
          <view wx:if="{{item.tasks.length === 0}}" class="empty-tasks">
            <text class="empty-text">暂无任务，去创建计划吧~</text>
          </view>
        </view>
      </view>
    </block>
    </view>

    <!-- 无任务空状态 -->
    <view wx:if="{{dimensions.length === 0}}" class="empty-state">
      <app-image class="empty-icon" src="/assets/images/empty.png" size="160" radius="24" fallbackText="📝" />
      <text class="empty-text">还没有创建计划哦</text>
      <button class="btn-primary mt-md" bindtap="goToPlan">创建计划</button>
    </view>

    <!-- 底部操作区 - 有任务时显示 -->
    <view wx:if="{{totalTasks > 0}}" class="bottom-action">
      <button class="btn-outline" bindtap="goToPlan">
        <text class="btn-icon">+</text>
        <text>添加计划</text>
      </button>
      <button class="btn-primary" bindtap="goToStatistics">查看数据</button>
    </view>

    <!-- 快速添加浮动按钮 -->
    <view wx:if="{{totalTasks > 0}}" class="fab-container">
      <!-- 展开的快捷菜单 -->
      <view class="fab-menu" wx:if="{{showFabMenu}}">
        <view class="fab-menu-item" bindtap="handleQuickCheckAll">
          <view class="fab-menu-icon icon-check">✓</view>
          <view class="fab-menu-content">
            <text class="fab-menu-text">快速全部打卡</text>
            <text class="fab-menu-desc">一键完成所有任务</text>
          </view>
        </view>
        <view class="fab-menu-item" bindtap="goToPlan">
          <view class="fab-menu-icon icon-add">+</view>
          <view class="fab-menu-content">
            <text class="fab-menu-text">添加新计划</text>
            <text class="fab-menu-desc">创建新的目标任务</text>
          </view>
        </view>
      </view>

      <!-- 主按钮 -->
      <view class="fab {{showFabMenu ? 'fab-active' : ''}}" bindtap="toggleFabMenu">
        <text class="fab-icon">{{showFabMenu ? '×' : '+'}}</text>
      </view>
    </view>
  </view> <!-- content-container 结束 -->
</view> <!-- page-container 结束 -->

<!-- 打卡弹窗 -->
<view wx:if="{{showCheckinModal}}" class="modal-mask" bindtap="closeCheckinModal"></view>
<view wx:if="{{showCheckinModal}}" class="modal-bottom">
  <view class="modal-header">
    <text class="modal-title">打卡：{{currentTask.title}}</text>
    <button class="btn-close" bindtap="closeCheckinModal">×</button>
  </view>

  <view class="modal-body">
    <!-- 日期选择 -->
    <view class="input-group">
      <text class="input-label">选择日期 📅</text>
      <picker
        mode="date"
        value="{{checkinDate}}"
        start="{{dateRangeStart}}"
        end="{{dateRangeEnd}}"
        bindchange="onCheckinDateChange">
        <view class="date-picker {{checkinDate === todayDate ? 'date-today' : ''}}">
          {{checkinDateDisplay}}
        </view>
      </picker>
    </view>

    <!-- 数值输入 -->
    <view wx:if="{{currentTask.type !== 'boolean'}}" class="input-group">
      <text class="input-label">完成情况</text>
      <input
        class="input-base"
        type="number"
        placeholder="请输入{{currentTask.unit}}"
        value="{{checkinValue}}"
        bindinput="onCheckinValueInput"/>
    </view>

    <!-- 备注输入 -->
    <view class="input-group">
      <text class="input-label">备注（选填）</text>
      <textarea
        class="textarea-base"
        placeholder="记录一下今天的感受..."
        maxlength="200"
        value="{{checkinRemark}}"
        bindinput="onCheckinRemarkInput">
      </textarea>
    </view>
  </view>

  <view class="modal-footer">
    <button class="btn-secondary modal-btn" bindtap="closeCheckinModal">取消</button>
    <button class="btn-primary modal-btn" bindtap="confirmCheckin">保存</button>
  </view>
</view>

<!-- 打卡成功反馈 -->
<view wx:if="{{showSuccessFeedback}}" class="success-feedback">
  <app-image class="coach-avatar-large" src="/assets/images/coach-happy.png" size="160" radius="24" fallbackText="🎉" />
  <view class="bubble">
    <text>{{successMessage}}</text>
  </view>
</view>

<!-- 分享海报 -->
<share-poster
  type="checkin"
  data="{{shareData}}"
  visible="{{showSharePoster}}"
  bind:close="closeSharePoster"
  bind:save="onSharePosterSave"
  bind:share="onSharePosterShare"
/>

<!-- 成就解锁动画 -->
<achievement-unlock
  show="{{showAchievementUnlock}}"
  achievement="{{currentAchievement}}"
  bind:close="handleAchievementClose"
  bind:share="handleAchievementShare"
/>
