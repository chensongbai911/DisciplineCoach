/* pages/onboarding/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #4FD1C5 0%, #3182CE 100%);
  padding: 80rpx 32rpx 180rpx;
  position: relative;
}

/* 进度指示器 */
.progress-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

.progress-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.progress-dot.active {
  width: 24rpx;
  height: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 255, 255, 0.4);
}

.progress-line {
  width: 60rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 12rpx;
  transition: all 0.3s ease;
}

.progress-line.active {
  background: #FFFFFF;
}

/* 步骤容器 */
.step-container {
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 欢迎页 */
.welcome-section {
  text-align: center;
}

.logo-image {
  margin: 40rpx auto 32rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.welcome-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.welcome-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  margin-bottom: 60rpx;
}

.feature-list {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(226, 232, 240, 0.6);
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.feature-info {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 6rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
}

/* 维度选择页 */
.dimension-section {
  text-align: center;
}

.coach-avatar {
  margin: 0 auto 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  animation: wiggle 2s ease-in-out infinite;
}

@keyframes wiggle {
  0%, 100% { transform: rotate(-2deg); }
  50% { transform: rotate(2deg); }
}

.section-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
  font-weight: 600;
}

.dimension-list {
  margin-bottom: 32rpx;
}

.dimension-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
  border: 3rpx solid transparent;
  position: relative;
  overflow: hidden;
}

.dimension-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(79, 209, 197, 0.1), transparent);
  transition: left 0.5s ease;
}

.dimension-card.selected::before {
  left: 100%;
}

.dimension-card.selected {
  background: linear-gradient(135deg, rgba(79, 209, 197, 0.15) 0%, rgba(49, 130, 206, 0.15) 100%);
  border-color: #4FD1C5;
  box-shadow: 0 8rpx 24rpx rgba(79, 209, 197, 0.3);
  transform: scale(1.02);
}

.dimension-checkbox {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #CBD5E0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.dimension-card.selected .dimension-checkbox {
  background: linear-gradient(135deg, #4FD1C5 0%, #3182CE 100%);
  border-color: #4FD1C5;
}

.check-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.dimension-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.dimension-info {
  flex: 1;
  text-align: left;
}

.dimension-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 6rpx;
}

.dimension-desc {
  display: block;
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
}

.tip-box {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 计划预览页 */
.plan-section {
  text-align: center;
}

.plan-preview-list {
  margin-bottom: 32rpx;
}

.plan-preview-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.plan-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.plan-icon {
  font-size: 40rpx;
}

.plan-details {
  flex: 1;
  text-align: left;
}

.plan-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 6rpx;
}

.plan-target {
  display: block;
  font-size: 24rpx;
  color: #4FD1C5;
  font-weight: 600;
}

.plan-status {
  font-size: 40rpx;
  color: #4FD1C5;
}

.info-box {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-start;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.6;
  text-align: left;
  font-weight: 500;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.btn-primary, .btn-secondary {
  height: 96rpx;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  border: none;
  letter-spacing: 1rpx;
}

.btn-primary::after, .btn-secondary::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #4FD1C5 0%, #3182CE 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(79, 209, 197, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.25);
}

.btn-primary[disabled] {
  opacity: 0.5;
  transform: none !important;
}

.btn-secondary {
  background: #FFFFFF;
  color: #718096;
  border: 2rpx solid #E2E8F0;
  width: 160rpx;
}

.btn-secondary:active {
  transform: scale(0.98);
  background: #F7FAFC;
}

.flex-1 {
  flex: 1;
}

/* 跳过按钮 */
.skip-btn {
  position: fixed;
  top: 80rpx;
  right: 32rpx;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  z-index: 99;
}

.skip-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}
