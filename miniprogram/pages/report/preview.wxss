/* pages/report/preview.wxss */
/* 报告预览页样式 */

.container {
  min-height: 100vh;
  background: #F7FAFC;
  padding: 32rpx;
}

/* 报告头部 */
.report-header {
  background: linear-gradient(135deg, #4FD1C5 0%, #38B2AC 100%);
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.report-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.report-date {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 数据概览 */
.summary-section {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 24rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.summary-item {
  text-align: center;
  padding: 24rpx;
  background: #F7FAFC;
  border-radius: 16rpx;
}

.summary-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #4FD1C5;
  margin-bottom: 8rpx;
}

.summary-label {
  display: block;
  font-size: 26rpx;
  color: #718096;
}

/* 图表区域 */
.charts-section {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 24rpx;
}

.chart-container {
  margin-bottom: 32rpx;
}

.chart-container:last-child {
  margin-bottom: 0;
}

.chart-title {
  display: block;
  font-size: 28rpx;
  color: #4A5568;
  margin-bottom: 16rpx;
}

.chart-placeholder {
  height: 400rpx;
  background: #F7FAFC;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #A0AEC0;
  font-size: 28rpx;
}

/* 成就展示 */
.achievements-section {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.achievement-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #F7FAFC;
  border-radius: 12rpx;
  gap: 12rpx;
}

.achievement-icon {
  font-size: 32rpx;
}

.achievement-name {
  font-size: 26rpx;
  color: #4A5568;
}

/* 底部操作 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  padding-top: 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-secondary {
  background: #EDF2F7;
  color: #4A5568;
}

.btn-primary {
  background: linear-gradient(135deg, #4FD1C5 0%, #38B2AC 100%);
  color: #FFFFFF;
}

.btn::after {
  border: none;
}
