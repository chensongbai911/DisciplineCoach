/* pages/feedback/index.wxss */

.container {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.required {
  color: #FF6B6B;
}

/* 反馈类型 */
.type-section {
  margin-bottom: 32rpx;
}

.type-options {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.type-option.active {
  background: #E8F5E9;
  border-color: #07C160;
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-text {
  font-size: 24rpx;
  color: #666666;
}

.type-option.active .type-text {
  color: #07C160;
  font-weight: 700;
}

/* 反馈内容 */
.content-section {
  margin-bottom: 32rpx;
}

.textarea-input {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 图片上传 */
.images-section {
  margin-bottom: 32rpx;
}

.images-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-delete {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF6B6B;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.4);
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #FFFFFF;
  border: 2rpx dashed #DDDDDD;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.image-add:active {
  background: #F7F8FA;
}

.add-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

.images-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 联系方式 */
.contact-section {
  margin-bottom: 32rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

/* 提交按钮 */
.submit-section {
  margin-bottom: 48rpx;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #07C160 0%, #05A950 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.btn-submit::after {
  border: none;
}

/* 历史反馈 */
.history-section {
  margin-top: 48rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.history-count {
  font-size: 24rpx;
  color: #999999;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.history-item:active {
  transform: scale(0.98);
}

.history-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-type {
  display: flex;
  align-items: center;
}

.type-badge {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.type-badge.bug {
  background: #FFE0E0;
  color: #FF6B6B;
}

.type-badge.feature {
  background: #E0F7FF;
  color: #3498DB;
}

.type-badge.other {
  background: #F0F0F0;
  color: #666666;
}

.history-date {
  font-size: 24rpx;
  color: #999999;
}

.history-status {
  font-size: 24rpx;
  font-weight: 500;
}

.history-status.pending {
  color: #F39C12;
}

.history-status.processing {
  color: #3498DB;
}

.history-status.resolved {
  color: #07C160;
}

.history-status.closed {
  color: #999999;
}

.history-content {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.history-reply {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #F7F8FA;
}

.reply-label {
  font-size: 24rpx;
  color: #999999;
}

.reply-content {
  font-size: 24rpx;
  color: #07C160;
}
