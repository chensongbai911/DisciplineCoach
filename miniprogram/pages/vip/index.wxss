/* pages/vip/index.wxss */

.container {
  min-height: 100vh;
  background: #F7F8FA;
  padding-bottom: 200rpx;
}

/* 会员状态卡片 */
.vip-status-card {
  margin: 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.vip-status-card.vip-active {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.3);
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.status-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.status-info {
  flex: 1;
}

.status-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.status-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.btn-renew {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-primary-small {
  background: #FFFFFF;
  color: #667EEA;
}

.btn-secondary-small {
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}

.btn-renew::after {
  border: none;
}

/* 会员权益 */
.benefits-section {
  padding: 32rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.benefit-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.benefit-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.benefit-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.benefit-desc {
  font-size: 20rpx;
  color: #999999;
  text-align: center;
  line-height: 1.4;
}

.benefit-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.4);
}

.badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 套餐选择 */
.plans-section {
  padding: 32rpx;
}

.plans-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card {
  position: relative;
  padding: 32rpx;
  background: #FFFFFF;
  border: 3rpx solid transparent;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.plan-card.selected {
  border-color: #07C160;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.plan-tag {
  position: absolute;
  top: -8rpx;
  right: 32rpx;
  padding: 8rpx 24rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #F7F8FA;
}

.plan-duration {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.plan-pricing {
  display: flex;
  align-items: baseline;
}

.plan-price {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.plan-original {
  font-size: 24rpx;
  color: #999999;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.plan-features {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.feature-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.plan-daily {
  font-size: 24rpx;
  color: #999999;
}

/* 购买区域 */
.purchase-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.purchase-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.purchase-price {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.price-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.btn-purchase {
  flex-shrink: 0;
  min-width: 280rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.4);
}

.btn-purchase::after {
  border: none;
}

.purchase-terms {
  text-align: center;
}

.terms-label {
  display: flex;
  align-items: center;
  justify-content: center;
}

.terms-text {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}

.terms-link {
  font-size: 24rpx;
  color: #07C160;
  margin-left: 4rpx;
}

/* 常见问题 */
.faq-section {
  padding: 32rpx;
}

.faq-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.faq-item {
  padding: 32rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.question-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.question-icon {
  font-size: 32rpx;
  color: #CCCCCC;
  transform: rotate(90deg);
  transition: transform 0.3s;
}

.question-icon.expanded {
  transform: rotate(270deg);
}

.faq-answer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F7F8FA;
}

.answer-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}
