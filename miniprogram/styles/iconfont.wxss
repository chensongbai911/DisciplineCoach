@font-face {
  font-family: 'iconfont';
  src: url('//at.alicdn.com/t/c/font_5094872_60e7nx4r6mr.woff2?t=1766394531251') format('woff2'),
       url('//at.alicdn.com/t/c/font_5094872_60e7nx4r6mr.woff?t=1766394531251') format('woff'),
       url('//at.alicdn.com/t/c/font_5094872_60e7nx4r6mr.ttf?t=1766394531251') format('truetype'),
       url('//at.alicdn.com/t/c/font_5094872_60e7nx4r6mr.svg?t=1766394531251#iconfont') format('svg');
