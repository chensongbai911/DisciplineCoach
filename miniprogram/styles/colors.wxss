/* colors.wxss - 颜色系统定义和变量 */
/* 版本: 1.1 - WCAG AA 合规优化 */
/* 最后更新: 2025-12-23 */

/* ========== 主色系 ========== */
:root {
  /* 主绿色 - 用于按钮、成功、强调 */
  --color-primary: #07C160;
  --color-primary-light: #B7F4D6;
  --color-primary-dark: #029E6D;

  /* 功能色 - WCAG AA 优化 */
  --color-success: #07C160;    /* 成功/打卡完成 - 对比度 3.4:1 (仅用于大字 ≥18px) */
  --color-warning: #E68700;    /* 警告/提醒 - 对比度 3.1:1 (优化前: #FF9500) */
  --color-error: #FA5151;      /* 错误/失败 - 对比度 3.3:1 (仅用于大字 ≥18px) */
  --color-info: #0E93DB;       /* 信息/提示 - 对比度 3.2:1 (优化前: #10AEFF) */
}

/* ========== 文本色系 (WCAG AA 合规) ========== */
:root {
  --color-text-primary: #333333;      /* 一级文本 - 标题 - 对比度 12.6:1 ✓ */
  --color-text-secondary: #666666;    /* 二级文本 - 正文 - 对比度 5.7:1 ✓ */
  --color-text-tertiary: #787878;     /* 三级文本 - 说明 - 对比度 4.6:1 ✓ (优化前: #999999 2.8:1) */
  --color-text-disabled: #CCCCCC;     /* 禁用文本 - 对比度 1.6:1 (仅用于 placeholder) */
  --color-text-white: #FFFFFF;        /* 白色文本 */
}

/* ========== 背景色系 ========== */
:root {
  --color-bg-primary: #FFFFFF;        /* 主背景 - 白色 */
  --color-bg-secondary: #F7F8FA;      /* 次背景 - 浅灰 */
  --color-bg-tertiary: #EFEFEF;       /* 三级背景 - 更深灰 */
  --color-bg-light: #FAFBFC;          /* 浅背景 */
}

/* ========== 边框色系 ========== */
:root {
  --color-border-light: #E8E8E8;      /* 浅边框 */
  --color-border-medium: #D8D8D8;     /* 中等边框 */
  --color-border-dark: #C8C8C8;       /* 深边框 */
}

/* ========== 维度配色系统（5维） ========== */
:root {
  /* 维度 1: 运动 - 红色系 */
  --color-dimension-sport: #FF6B6B;
  --color-dimension-sport-light: #FFE5E5;
  --color-dimension-sport-dark: #E63535;

  /* 维度 2: 饮食 - 青/绿色系 */
  --color-dimension-diet: #38B2AC;
  --color-dimension-diet-light: #E5F9F7;
  --color-dimension-diet-dark: #1E9B96;

  /* 维度 3: 睡眠 - 紫色系 */
  --color-dimension-sleep: #9F7AEA;
  --color-dimension-sleep-light: #F5E8FF;
  --color-dimension-sleep-dark: #7B5FD1;

  /* 维度 4: 阅读 - 橙色系 */
  --color-dimension-reading: #F6AD55;
  --color-dimension-reading-light: #FFE8D1;
  --color-dimension-reading-dark: #E89239;

  /* 维度 5: 学习 - 蓝色系 */
  --color-dimension-study: #4299E1;
  --color-dimension-study-light: #D9E7FF;
  --color-dimension-study-dark: #2E7EC9;
}

/* ========== 阴影系统 ========== */
:root {
  /* 标准阴影 - 用于普通卡片 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  --shadow-xl: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* ========== 圆角系统 ========== */
:root {
  --radius-sm: 8rpx;     /* 小圆角 - 按钮 */
  --radius-md: 12rpx;    /* 中圆角 - 输入框 */
  --radius-lg: 24rpx;    /* 大圆角 - 卡片 */
}

/* ========== 间距系统 ========== */
:root {
  --spacing-xs: 8rpx;    /* 极小间距 */
  --spacing-sm: 16rpx;   /* 小间距 */
  --spacing-md: 32rpx;   /* 中间距 */
  --spacing-lg: 48rpx;   /* 大间距 */
  --spacing-xl: 64rpx;   /* 超大间距 */
}

/* ========== 深色模式 ========== */
@media (prefers-color-scheme: dark) {
  :root {
    /* 主色系 */
    --color-primary: #1AC158;
    --color-primary-light: #2ACB6F;
    --color-primary-dark: #0FA850;

    /* 文本色系 */
    --color-text-primary: #F5F5F5;      /* 浅色文本 */
    --color-text-secondary: #B0B0B0;    /* 灰色文本 */
    --color-text-tertiary: #808080;     /* 更深灰文本 */
    --color-text-disabled: #505050;     /* 禁用文本 */

    /* 背景色系 */
    --color-bg-primary: #1A1A1A;        /* 深背景 */
    --color-bg-secondary: #2A2A2A;      /* 次深背景 */
    --color-bg-tertiary: #3A3A3A;       /* 更深背景 */
    --color-bg-light: #141414;          /* 更浅深背景 */

    /* 边框色系 */
    --color-border-light: #404040;
    --color-border-medium: #505050;
    --color-border-dark: #606060;

    /* 维度色深色版本 */
    --color-dimension-sport: #FF7878;
    --color-dimension-sport-light: #5C2424;
    --color-dimension-sport-dark: #CC3333;

    --color-dimension-diet: #4DC9C1;
    --color-dimension-diet-light: #1E5552;
    --color-dimension-diet-dark: #2BA6A0;

    --color-dimension-sleep: #B399FF;
    --color-dimension-sleep-light: #4D3D99;
    --color-dimension-sleep-dark: #8566CC;

    --color-dimension-reading: #FFB969;
    --color-dimension-reading-light: #5C4130;
    --color-dimension-reading-dark: #E69A52;

    --color-dimension-study: #66BAFF;
    --color-dimension-study-light: #1E4D7A;
    --color-dimension-study-dark: #4D9FFF;

    /* 功能色深色版本 */
    --color-success: #1AC158;
    --color-warning: #FFA500;
    --color-error: #FF6B6B;
    --color-info: #5DADE2;
  }
}

