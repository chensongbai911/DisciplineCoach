/* ========== 布局工具类 ========== */
.flex { display: flex; }
.flex-column { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.flex-nowrap { flex-wrap: nowrap; }

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-around {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.flex-start { justify-content: flex-start; }
.flex-end { justify-content: flex-end; }
.flex-align-start { align-items: flex-start; }
.flex-align-center { align-items: center; }
.flex-align-end { align-items: flex-end; }

.flex-1 { flex: 1; }
.flex-2 { flex: 2; }
.flex-3 { flex: 3; }

/* ========== 圆角工具类 ========== */
.radius-none { border-radius: 0; }
.radius-sm { border-radius: 8rpx; }
.radius-md { border-radius: 16rpx; }
.radius-lg { border-radius: 24rpx; }
.radius-xl { border-radius: 32rpx; }
.radius-round { border-radius: 50%; }
.radius-circle { border-radius: 50%; }

/* ========== 阴影工具类 ========== */
.shadow-none { box-shadow: none; }
.shadow-sm { box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08); }
.shadow-md { box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }
.shadow-lg { box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12); }

/* ========== 边框工具类 ========== */
.border { border: 2rpx solid #EEEEEE; }
.border-top { border-top: 2rpx solid #EEEEEE; }
.border-right { border-right: 2rpx solid #EEEEEE; }
.border-bottom { border-bottom: 2rpx solid #EEEEEE; }
.border-left { border-left: 2rpx solid #EEEEEE; }

.border-none { border: none; }
.border-primary { border-color: #07C160; }
.border-error { border-color: #FA5151; }

/* ========== 宽高工具类 ========== */
.w-100 { width: 100%; }
.h-100 { height: 100%; }
.w-50 { width: 50%; }
.h-50 { height: 50%; }

/* ========== 定位工具类 ========== */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }

/* ========== 显示隐藏 ========== */
.block { display: block; }
.inline-block { display: inline-block; }
.inline { display: inline; }
.hidden { display: none; }
.invisible { visibility: hidden; }

/* ========== 卡片样式 ========== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.card-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* ========== 按钮样式 ========== */
.btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 16rpx;
  border: none;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  border-radius: 24rpx;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.btn-primary[disabled] {
  background: #EEEEEE;
  color: #CCCCCC;
  box-shadow: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.95);
  color: #667eea;
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  font-weight: 600;
}

.btn-secondary:active {
  background: rgba(102, 126, 234, 0.1);
  border-color: #667eea;
}

.btn-text {
  background: transparent;
  color: #576B95;
  font-size: 28rpx;
  padding: 0;
  height: auto;
}

.btn-text:active {
  color: #07C160;
}

.btn-small {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  width: auto;
  display: inline-flex;
}

/* ========== 输入框样式 ========== */
.input-base {
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333333;
}

.input-base:focus {
  border-color: #07C160;
}

.input-error {
  border-color: #FA5151;
}

/* ========== 标签样式 ========== */
.tag {
  display: inline-flex;
  height: 48rpx;
  padding: 0 16rpx;
  background: #F0F0F0;
  color: #666666;
  font-size: 24rpx;
  border-radius: 8rpx;
  align-items: center;
  justify-content: center;
}

.tag-primary {
  background: #E6F7ED;
  color: #07C160;
}

.tag-warning {
  background: #FFF7E6;
  color: #FF9500;
}

.tag-error {
  background: #FFEDED;
  color: #FA5151;
}

/* ========== 进度条样式 ========== */
.progress-bar {
  width: 100%;
  height: 20rpx;
  background: rgba(79, 209, 197, 0.12);
  border-radius: 10rpx;
  overflow: hidden;
  position: relative;
}

.progress-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4FD1C5 0%, #3182CE 100%);
  border-radius: 10rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.4);
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3));
  border-radius: 8rpx;
}

/* ========== 空状态样式 ========== */
.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* ========== 加载状态 ========== */
.loading {
  padding: 40rpx;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
}

/* ========== 动画类 ========== */
.fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.slide-in-up {
  animation: slideInUp 0.3s ease;
}

@keyframes slideInUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.scale-in {
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}
