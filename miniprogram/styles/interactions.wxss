/**
 * 交互增强样式 - 全局视觉反馈和动画
 * 提升按钮响应性和用户体验
 */

/* ==================== 按钮视觉反馈系统 ==================== */

/* 主按钮增强 */
.btn-primary {
  position: relative;
  overflow: hidden;
  touch-action: manipulation;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-primary::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
  z-index: 0;
}

.btn-primary:active::before {
  width: 300%;
  height: 300%;
}

.btn-primary:active {
  transform: scale(0.95);
}

/* 次要按钮增强 */
.btn-secondary {
  transition: all 0.2s ease;
  touch-action: manipulation;
}

.btn-secondary:active {
  background: #EDF2F7;
  transform: scale(0.98);
}

/* 文本按钮增强 */
.btn-text {
  transition: all 0.2s ease;
  touch-action: manipulation;
}

.btn-text:active {
  opacity: 0.6;
  transform: scale(0.95);
}

/* 图标按钮增强 */
.btn-icon {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
  touch-action: manipulation;
}

.btn-icon:active {
  background: rgba(0, 0, 0, 0.05);
  transform: scale(0.9);
}

/* 关闭按钮统一样式 */
.btn-close,
.modal-close,
.guide-close,
.picker-close {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
  cursor: pointer;
  touch-action: manipulation;
}

.btn-close:active,
.modal-close:active,
.guide-close:active,
.picker-close:active {
  background: rgba(0, 0, 0, 0.05);
  transform: scale(0.9);
}

/* ==================== 卡片交互增强 ==================== */

/* 可点击卡片 */
.card-interactive {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  touch-action: manipulation;
}

.card-interactive:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.06),
    0 1rpx 2rpx rgba(0, 0, 0, 0.03);
}

/* 列表项交互 */
.list-item-interactive {
  transition: all 0.2s ease;
  touch-action: manipulation;
}

.list-item-interactive:active {
  background: #F7FAFC;
  transform: scale(0.98);
}

/* ==================== 模态框动画 ==================== */

/* 遮罩渐入 */
.modal-mask {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 底部弹出 */
.modal-bottom {
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 中心缩放 */
.modal-center {
  animation: zoomIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes zoomIn {
  from {
    opacity: 0;
    transform: scale(0.7);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ==================== 列表动画 ==================== */

/* 列表项交错渐入 */
.list-item-animated {
  animation: listItemFadeIn 0.4s ease backwards;
}

.list-item-animated:nth-child(1) { animation-delay: 0.05s; }
.list-item-animated:nth-child(2) { animation-delay: 0.10s; }
.list-item-animated:nth-child(3) { animation-delay: 0.15s; }
.list-item-animated:nth-child(4) { animation-delay: 0.20s; }
.list-item-animated:nth-child(5) { animation-delay: 0.25s; }
.list-item-animated:nth-child(6) { animation-delay: 0.30s; }
.list-item-animated:nth-child(7) { animation-delay: 0.35s; }
.list-item-animated:nth-child(8) { animation-delay: 0.40s; }

@keyframes listItemFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== Loading状态 ==================== */

/* 按钮Loading */
.btn-loading {
  opacity: 0.6;
  pointer-events: none;
  position: relative;
}

.btn-loading::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 32rpx;
  height: 32rpx;
  margin: -16rpx 0 0 -16rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  z-index: 10;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ==================== 触摸反馈涟漪效果 ==================== */

.ripple {
  position: relative;
  overflow: hidden;
}

.ripple::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transform: translate(-50%, -50%);
  transition: width 0.5s, height 0.5s, opacity 0.5s;
  opacity: 0;
}

.ripple:active::after {
  width: 200%;
  height: 200%;
  opacity: 1;
}

/* ==================== 卡片阴影系统 ==================== */

/* 三级阴影 */
.shadow-sm {
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 1rpx 2rpx rgba(0, 0, 0, 0.02);
}

.shadow-md {
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.08),
    0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.shadow-lg {
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.12),
    0 4rpx 8rpx rgba(0, 0, 0, 0.06),
    0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

/* 悬浮阴影 */
.shadow-float {
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* ==================== 渐变色系统 ==================== */

.gradient-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.gradient-success {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
}

.gradient-warning {
  background: linear-gradient(135deg, #f6ad55 0%, #ed8936 100%);
}

.gradient-danger {
  background: linear-gradient(135deg, #fc8181 0%, #f56565 100%);
}

.gradient-info {
  background: linear-gradient(135deg, #4299e1 0%, #3182ce 100%);
}

/* ==================== 维度主题色 ==================== */

.theme-exercise {
  --theme-color: #FF6B6B;
  --theme-bg: rgba(255, 107, 107, 0.1);
  --theme-gradient: linear-gradient(135deg, #FF6B6B 0%, #EE5A6F 100%);
}

.theme-diet {
  --theme-color: #4ECDC4;
  --theme-bg: rgba(78, 205, 196, 0.1);
  --theme-gradient: linear-gradient(135deg, #4ECDC4 0%, #44A08D 100%);
}

.theme-sleep {
  --theme-color: #9B59B6;
  --theme-bg: rgba(155, 89, 182, 0.1);
  --theme-gradient: linear-gradient(135deg, #9B59B6 0%, #8E44AD 100%);
}

.theme-reading {
  --theme-color: #F39C12;
  --theme-bg: rgba(243, 156, 18, 0.1);
  --theme-gradient: linear-gradient(135deg, #F39C12 0%, #E67E22 100%);
}

.theme-study {
  --theme-color: #3498DB;
  --theme-bg: rgba(52, 152, 219, 0.1);
  --theme-gradient: linear-gradient(135deg, #3498DB 0%, #2980B9 100%);
}

/* ==================== 页面过渡 ==================== */

.page-enter {
  animation: pageSlideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes pageSlideIn {
  from {
    opacity: 0;
    transform: translateX(100rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ==================== 微交互 ==================== */

/* 脉冲效果 */
.pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 弹跳效果 */
.bounce {
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

/* 摇晃效果 */
.shake {
  animation: shake 0.5s;
}

@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  10%, 30%, 50%, 70%, 90% {
    transform: translateX(-10rpx);
  }
  20%, 40%, 60%, 80% {
    transform: translateX(10rpx);
  }
}

/* ==================== 工具类 ==================== */

/* 禁用点击 */
.no-touch {
  pointer-events: none;
  touch-action: none;
}

/* 增强点击区域 */
.touch-area {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 平滑过渡 */
.transition-all {
  transition: all 0.3s ease;
}

.transition-fast {
  transition: all 0.15s ease;
}

.transition-slow {
  transition: all 0.5s ease;
}

/* 转换 */
.transform-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
