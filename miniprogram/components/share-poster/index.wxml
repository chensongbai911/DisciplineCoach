<view class="share-poster-container" wx:if="{{visible}}">
  <!-- 遮罩层 -->
  <view class="mask" bindtap="handleClose"></view>

  <!-- 海报内容 -->
  <view class="poster-content" catchtap="preventBubble">
    <!-- Canvas画布 (隐藏) -->
    <canvas
      id="shareCanvas"
      canvas-id="shareCanvas"
      class="canvas-hidden"
      style="width: 750px; height: 1334px;"
    ></canvas>

    <!-- 海报预览 -->
    <view class="poster-preview" wx:if="{{showPoster}}">
      <image
        class="poster-image"
        src="{{posterPath}}"
        mode="widthFix"
        show-menu-by-longpress
      ></image>
    </view>

    <!-- 加载中 -->
    <view class="loading-box" wx:if="{{isGenerating}}">
      <view class="loading-icon"></view>
      <text class="loading-text">生成中...</text>
    </view>

    <!-- 操作按钮 -->
    <view class="actions" wx:if="{{showPoster}}">
      <!-- 主要操作：分享 -->
      <button class="action-btn primary" open-type="share" bindtap="handleShare">
        <app-icon name="share" size="22" color="#fff"></app-icon>
        <text>分享好友</text>
      </button>

      <!-- 次要操作 -->
      <view class="secondary-actions">
        <button class="action-btn secondary small" bindtap="handleSave">
          <app-icon name="download" size="20" color="#666"></app-icon>
          <text>保存相册</text>
        </button>

        <button class="action-btn secondary small" bindtap="handleRegenerate">
          <app-icon name="refresh" size="20" color="#666"></app-icon>
          <text>重新生成</text>
        </button>
      </view>
    </view>

    <!-- 关闭按钮 -->
    <view class="close-btn" bindtap="handleClose">
      <app-icon name="close" size="24" color="#fff"></app-icon>
    </view>

    <!-- 提示文字 -->
    <view class="tips" wx:if="{{showPoster}}">
      <text>长按图片可直接分享或保存</text>
    </view>
  </view>
</view>
