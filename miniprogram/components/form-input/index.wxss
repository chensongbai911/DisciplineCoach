/* components/form-input/index.wxss */

.form-input {
  margin-bottom: 32rpx;
}

/* 标签 */
.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
}

.label-required {
  color: #F56565;
  margin-left: 4rpx;
  font-size: 28rpx;
}

/* 输入框容器 */
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

/* 普通输入框 */
.input-control {
  flex: 1;
  height: 88rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #2D3748;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.input-control:focus {
  background: #FFFFFF;
  border-color: #4FD1C5;
}

.input-control[disabled] {
  color: #A0AEC0;
  background: #EDF2F7;
}

/* 多行文本框 */
.textarea-control {
  flex: 1;
  min-height: 160rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #2D3748;
  background: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  line-height: 1.6;
  transition: all 0.3s;
}

.textarea-control:focus {
  background: #FFFFFF;
  border-color: #4FD1C5;
}

/* 验证状态样式 */
.form-input.success .input-control,
.form-input.success .textarea-control {
  border-color: #48BB78;
}

.form-input.error .input-control,
.form-input.error .textarea-control {
  border-color: #F56565;
  background: #FFF5F5;
}

/* 状态图标 */
.status-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.icon-loading {
  font-size: 32rpx;
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.icon-success {
  color: #48BB78;
  font-size: 32rpx;
  font-weight: 700;
}

.icon-error {
  color: #F56565;
  font-size: 32rpx;
  font-weight: 700;
}

/* 字数统计 */
.input-count {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.count-text {
  font-size: 24rpx;
  color: #A0AEC0;
}

.count-limit {
  color: #F56565;
}

/* 错误提示 */
.error-message {
  margin-top: 12rpx;
  padding-left: 8rpx;
}

.error-text {
  font-size: 24rpx;
  color: #F56565;
  line-height: 1.4;
}

/* 动画 */
.error-message {
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
