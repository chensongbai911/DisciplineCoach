<view class="swipe-action">
  <!-- 内容区域 -->
  <view
    class="swipe-content {{isOpen ? 'open' : ''}}"
    style="transform: translateX({{moveX || 0}}px); transition: {{transitionStyle}}"
    catchtouchstart="handleTouchStart"
    catchtouchmove="handleTouchMove"
    catchtouchend="handleTouchEnd"
    bindtap="handleContentTap">
    <slot name="content"></slot>
  </view>

  <!-- 右侧动作按钮 -->
  <view class="swipe-actions" style="width: {{actionsWidth}}rpx">
    <view
      class="action-item action-{{item.type || 'default'}}"
      wx:for="{{actions}}"
      wx:key="text"
      data-index="{{index}}"
      catchtap="handleActionTap">
      <text class="action-icon" wx:if="{{item.icon}}">{{item.icon}}</text>
      <text class="action-text">{{item.text}}</text>
    </view>
  </view>
</view>
