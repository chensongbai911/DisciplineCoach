.swipe-action {
  position: relative;
  overflow: visible;
  width: 100%;
}

/* 内容区域 */
.swipe-content {
  position: relative;
  z-index: 2;
  background: #ffffff;
  width: 100%;
  will-change: transform;
  touch-action: pan-y;
}

.swipe-content.open {
  box-shadow: -4rpx 0 12rpx rgba(0, 0, 0, 0.15);
}

/* 右侧动作按钮容器 */
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  z-index: 1;
}

/* 单个动作按钮 */
.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 0 16rpx;
  color: #ffffff;
  font-size: 24rpx;
  transition: background-color 0.2s;
}

.action-item:active {
  opacity: 0.8;
}

/* 图标 */
.action-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

/* 文字 */
.action-text {
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 按钮样式变体 */
.action-default {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.action-primary {
  background: linear-gradient(135deg, #4FD1C5 0%, #38B2AC 100%);
}

.action-warning {
  background: linear-gradient(135deg, #F6AD55 0%, #ED8936 100%);
}

.action-danger {
  background: linear-gradient(135deg, #FC8181 0%, #F56565 100%);
}

.action-success {
  background: linear-gradient(135deg, #68D391 0%, #48BB78 100%);
}

/* 深色模式适配 */
page[data-theme="dark"] .swipe-content {
  background: #2d2d2d;
}

page[data-theme="dark"] .swipe-content.open {
  box-shadow: -2rpx 0 8rpx rgba(0, 0, 0, 0.3);
}
