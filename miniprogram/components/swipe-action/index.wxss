.swipe-action {
  position: relative;
  overflow: hidden;  /* 修复：隐藏超出部分，防止按钮默认显示 */
  width: 100%;
}

/* 内容区域 */
.swipe-content {
  position: relative;
  z-index: 2;
  background: #ffffff;
  width: 100%;
  will-change: transform;
  touch-action: pan-y;
  transform: translateX(0);  /* 确保初始位置为0 */
}

.swipe-content.open {
  box-shadow: -4rpx 0 12rpx rgba(0, 0, 0, 0.15);
}

/* 右侧动作按钮容器 */
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  z-index: 1;
}

/* 单个动作按钮 */
.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 0 20rpx;
  color: #ffffff;
  font-size: 24rpx;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.action-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0);
  transition: background 0.2s ease;
}

.action-item:active::before {
  background: rgba(255, 255, 255, 0.2);
}

/* 图标 */
.action-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.15));
}

/* 文字 */
.action-text {
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 按钮样式变体 */
.action-default {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.action-primary {
  background: linear-gradient(135deg, #4FD1C5 0%, #38B2AC 100%);
}

.action-warning {
  background: linear-gradient(135deg, #F6AD55 0%, #ED8936 100%);
}

.action-danger {
  background: linear-gradient(135deg, #FC8181 0%, #F56565 100%);
}

.action-success {
  background: linear-gradient(135deg, #68D391 0%, #48BB78 100%);
}

/* 深色模式适配 */
page[data-theme="dark"] .swipe-content {
  background: #2d2d2d;
}

page[data-theme="dark"] .swipe-content.open {
  box-shadow: -2rpx 0 8rpx rgba(0, 0, 0, 0.3);
}
