<view class="app-image" style="width: {{size}}rpx; height: {{size}}rpx; {{customStyle}}">
  <image
    wx:if="{{!error}}"
    class="img"
    src="{{src}}"
    mode="{{mode}}"
    binderror="onError"
    style="border-radius: {{radius}}rpx;"
  />
  <view wx:else class="fallback" style="width: 100%; height: 100%; border-radius: {{radius}}rpx;">
    <text wx:if="{{fallbackText}}" class="fallback-text">{{fallbackText}}</text>
    <icon wx:else type="{{fallbackIconType}}" size="{{Math.floor(size*0.6)}}" />
  </view>
</view>
