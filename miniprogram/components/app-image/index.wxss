.app-image {
  display: inline-block;
  overflow: hidden;
  position: relative;
}

.img {
  width: 100%;
  height: 100%;
  display: block;
  transition: opacity 0.3s ease;
}

.img-loading {
  opacity: 0;
}

.img-loaded {
  opacity: 1;
}

.loading-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  background: #f5f6f7;
  overflow: hidden;
}

.loading-shimmer {
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    #f5f6f7 0%,
    #edeef0 50%,
    #f5f6f7 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f7;
  color: #999;
}

.fallback-text {
  font-size: 48rpx;
}
