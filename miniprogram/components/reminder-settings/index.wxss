.reminder-settings-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  animation: fadeIn 0.3s ease;
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  animation: slideUp 0.3s ease;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-close {
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 内容区 */
.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 40rpx 60rpx;
}

/* 设置分组 */
.setting-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 24rpx;
}

.section-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.section-item:last-child {
  border-bottom: none;
}

.item-label {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.label-icon {
  font-size: 48rpx;
  line-height: 1;
}

.label-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.label-desc {
  font-size: 24rpx;
  color: #999;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  padding-left: 60rpx;
}

/* 智能推荐 */
.recommend-box {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFE8CC 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.recommend-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E67E22;
}

.recommend-content {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.recommend-text {
  font-size: 28rpx;
  color: #666;
}

.recommend-time {
  font-size: 40rpx;
  font-weight: 700;
  color: #E67E22;
}

.recommend-btn {
  background: #FFD700;
  color: #333;
  border: none;
  border-radius: 40rpx;
  font-weight: 600;
}

/* 时间选择器 */
.time-selector {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: #f7f8fa;
  border-radius: 20rpx;
}

.time-text {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 提示 */
.setting-tip {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 20rpx;
  margin-top: 32rpx;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* 系统设置按钮 */
.system-settings-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: 2rpx solid #4FD1C5;
  border-radius: 20rpx;
  margin-top: 32rpx;
}

.btn-text {
  font-size: 28rpx;
  color: #4FD1C5;
  font-weight: 600;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
