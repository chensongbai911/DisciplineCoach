/* components/trend-chart/index.wxss */

.trend-chart {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 头部 */
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3748;
}

.chart-legend {
  display: flex;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 24rpx;
  color: #718096;
}

/* 图表容器 */
.chart-container {
  display: flex;
  height: 400rpx;
}

/* Y轴 */
.y-axis {
  width: 60rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx 0;
}

.y-label {
  font-size: 22rpx;
  color: #A0AEC0;
  text-align: right;
}

/* 图表区域 */
.chart-area {
  flex: 1;
  position: relative;
  margin-left: 16rpx;
}

/* 网格线 */
.grid-lines {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx 0;
}

.grid-line {
  height: 1rpx;
  background: #E2E8F0;
}

/* 折线路径 */
.line-path {
  position: absolute;
  inset: 0;
  padding: 20rpx 0;
}

.line-segment {
  position: absolute;
  height: 4rpx;
  border-radius: 2rpx;
  transform-origin: left center;
}

/* 数据点 */
.data-points {
  position: absolute;
  inset: 0;
  padding: 20rpx 0;
}

.data-point {
  position: absolute;
  transform: translate(-50%, 50%);
  z-index: 10;
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.data-point:active .point-dot {
  transform: scale(1.5);
}

.point-value {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #4FD1C5;
  font-weight: 700;
  white-space: nowrap;
}

/* X轴 */
.x-axis {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  display: flex;
  justify-content: space-between;
}

.x-label {
  position: absolute;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #A0AEC0;
  white-space: nowrap;
}

/* 提示框 */
.chart-tooltip {
  position: fixed;
  background: rgba(45, 55, 72, 0.95);
  color: #FFFFFF;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.2);
  animation: tooltipFadeIn 0.2s ease;
}

@keyframes tooltipFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tooltip-date {
  font-weight: 700;
}

.tooltip-value {
  font-size: 22rpx;
  opacity: 0.9;
}
