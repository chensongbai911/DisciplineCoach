<!--components/calendar/index.wxml-->
<!-- 日历组件 -->

<view class="calendar-container">
  <!-- 月份选择器 -->
  <view class="calendar-header">
    <view class="month-selector">
      <view class="btn-prev" bindtap="prevMonth">
        <text>‹</text>
      </view>
      <view class="month-title">
        <text>{{year}}年{{month}}月</text>
      </view>
      <view class="btn-next" bindtap="nextMonth">
        <text>›</text>
      </view>
    </view>
    <view class="today-btn" bindtap="goToday">
      <text>今天</text>
    </view>
  </view>

  <!-- 星期标题 -->
  <view class="weekday-header">
    <text class="weekday-item">日</text>
    <text class="weekday-item">一</text>
    <text class="weekday-item">二</text>
    <text class="weekday-item">三</text>
    <text class="weekday-item">四</text>
    <text class="weekday-item">五</text>
    <text class="weekday-item">六</text>
  </view>

  <!-- 日期网格 -->
  <view class="calendar-grid">
    <view
      class="day-cell {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.hasRecord ? 'has-record' : ''}} {{item.isOtherMonth ? 'other-month' : ''}} {{item.isFuture ? 'future' : ''}}"
      wx:for="{{days}}"
      wx:key="date"
      bindtap="selectDate"
      data-date="{{item.date}}"
      data-can-select="{{!item.isFuture && !item.isOtherMonth}}"
    >
      <text class="day-number">{{item.day}}</text>
      <view class="day-indicator" wx:if="{{item.hasRecord}}">
        <view class="dot completed" wx:if="{{item.status === 'completed'}}"></view>
        <view class="dot partial" wx:if="{{item.status === 'partial'}}"></view>
        <view class="dot missed" wx:if="{{item.status === 'missed'}}"></view>
      </view>
    </view>
  </view>

  <!-- 图例说明 -->
  <view class="calendar-legend">
    <view class="legend-item">
      <view class="legend-dot completed"></view>
      <text class="legend-text">已完成</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot partial"></view>
      <text class="legend-text">部分完成</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot missed"></view>
      <text class="legend-text">未完成</text>
    </view>
  </view>

  <!-- 选中日期详情 -->
  <view class="selected-date-info" wx:if="{{selectedDateInfo}}">
    <view class="info-header">
      <text class="info-date">{{selectedDateInfo.dateText}}</text>
      <view class="info-status {{selectedDateInfo.statusClass}}">
        <text>{{selectedDateInfo.statusText}}</text>
      </view>
    </view>

    <view class="info-content" wx:if="{{selectedDateInfo.canCheckin}}">
      <text class="info-tip">{{selectedDateInfo.tipText}}</text>
      <button class="btn-checkin" bindtap="handleCheckin">
        {{selectedDateInfo.buttonText}}
      </button>
    </view>
  </view>
</view>
